@model MyVillageApp.Models.Account.ForgotPasswordPhoneModel

@{
    ViewData["Title"] = "Jangiligonda Village App";
}

<style>
    .forgot-wrapper {
        min-height: 100vh;
    }

    .forgot-card {
        border: 0;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.12);
        background: #fff;
    }

    .forgot-left {
        background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%);
        padding: 3rem;
    }

    .forgot-right {
        background: linear-gradient(135deg, #d1fae5 0%, #ecfdf5 100%);
        min-height: 620px;
        padding: 2rem;
    }

    .main-title {
        font-size: 2rem;
        font-weight: 700;
        color: #198754;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .forgot-heading {
        font-size: 1.8rem;
        font-weight: 700;
        color: #0d6efd;
    }

    .forgot-subtitle {
        color: #6c757d;
        font-size: 1rem;
    }

    .forgot-icon {
        width: 72px;
        height: 72px;
        object-fit: contain;
    }

    .form-label {
        font-weight: 600;
    }

    .form-control {
        border-radius: 14px;
        padding: 0.9rem 1rem;
        border: 1px solid #dbe4f0;
    }

        .form-control:focus {
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
            border-color: #86b7fe;
        }

    .forgot-btn {
        border-radius: 14px;
        padding: 0.9rem 1rem;
        font-weight: 600;
        font-size: 1.05rem;
    }

    .village-side-image {
        border-radius: 18px;
        width: 100%;
        object-fit: cover;
        box-shadow: 0 10px 24px rgba(0,0,0,0.10);
    }

    .village-stack img {
        max-height: 170px;
    }

    .slide-image {
        max-height: 470px;
        width: 100%;
        object-fit: cover;
        border-radius: 22px;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.14);
        transition: opacity 0.7s ease-in-out;
    }

    .right-caption {
        margin-top: 1.25rem;
    }

        .right-caption h4 {
            font-weight: 700;
            color: #198754;
            margin-bottom: 0.5rem;
        }

        .right-caption p {
            color: #6b7280;
            margin-bottom: 0;
        }

    @@media (max-width: 991px) {
        .forgot-left,
        .forgot-right {
            padding: 2rem;
        }

        .forgot-right {
            min-height: 400px;
        }

        .slide-image {
            max-height: 320px;
        }
    }

    @@media (max-width: 767px) {
        .forgot-wrapper {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }

        .forgot-card {
            border-radius: 20px;
        }

        .forgot-left,
        .forgot-right {
            padding: 1.25rem;
        }

        .main-title {
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        .forgot-heading {
            font-size: 1.4rem;
        }

        .forgot-subtitle {
            font-size: 0.95rem;
        }

        .forgot-right {
            min-height: auto;
        }

        .slide-image {
            max-height: 240px;
            border-radius: 16px;
        }

        .form-control {
            font-size: 0.95rem;
            padding: 0.8rem 0.9rem;
        }

        .forgot-btn {
            font-size: 1rem;
        }

        .village-stack img {
            max-height: 130px;
        }
    }
</style>

<div class="container forgot-wrapper py-4 py-md-5">

    <h2 class="main-title">Jangiligonda Village App – Development</h2>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">
            <div class="card forgot-card">
                <div class="row g-0">

                    <!-- LEFT SIDE FORM -->
                    <div class="col-lg-6 forgot-left">

                        <div class="text-center mb-3">
                            <img src="https://cdn-icons-png.flaticon.com/512/597/597177.png"
                                 alt="Forgot Password"
                                 class="forgot-icon" />
                        </div>

                        <div class="text-center mb-4">
                            <h3 class="forgot-heading mb-2">Forgot Password</h3>
                            <p class="forgot-subtitle mb-0">
                                Enter your registered phone number to continue password recovery.
                            </p>
                        </div>

                        <form asp-action="ForgotPasswordByPhone" method="post">

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       placeholder="Enter Phone Number" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-primary forgot-btn w-100">
                                Continue
                            </button>

                        </form>

                        <!-- VILLAGE IMAGES BELOW FORM -->
                        <div class="mt-4 village-stack">
                            <img src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=900&q=80"
                                 alt="Village"
                                 class="village-side-image mb-3" />

                            <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=900&q=80"
                                 alt="Village Nature"
                                 class="village-side-image" />
                        </div>

                    </div>

                    <!-- RIGHT SIDE SLIDESHOW -->
                    <div class="col-lg-6 d-flex align-items-center justify-content-center forgot-right">
                        <div class="text-center w-100">
                            <img id="villageSlide"
                                 class="img-fluid slide-image"
                                 alt="Village Slideshow" />

                            <div class="right-caption">
                                <h4>Secure Password Recovery</h4>
                                <p>Stay connected to your village portal with a fast and easy recovery flow.</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<script>
    const images = [
        "https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=900&q=80",
        "https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=900&q=80",
        "https://images.unsplash.com/photo-1502082553048-f009c37129b9?auto=format&fit=crop&w=900&q=80",
        "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=900&q=80"
    ];

    let index = 0;
    const villageSlide = document.getElementById("villageSlide");

    function changeImage() {
        villageSlide.style.opacity = 0.25;

        setTimeout(() => {
            villageSlide.src = images[index];
            villageSlide.style.opacity = 1;

            index++;
            if (index >= images.length) {
                index = 0;
            }
        }, 250);
    }

    changeImage();
    setInterval(changeImage, 3000);
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}