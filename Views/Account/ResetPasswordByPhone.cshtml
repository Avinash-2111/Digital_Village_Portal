@model MyVillageApp.Models.Account.ResetPasswordModel

@{
    ViewData["Title"] = "Jangiligonda Village App – Development";
}

<style>
    .reset-wrapper {
        min-height: 100vh;
    }

    .reset-card {
        border: 0;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.12);
        background: #fff;
    }

    .reset-left {
        background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%);
        padding: 3rem;
    }

    .reset-right {
        background: linear-gradient(135deg, #dcfce7 0%, #ecfdf5 100%);
        min-height: 620px;
        padding: 2rem;
    }

    .main-title {
        font-size: 2rem;
        font-weight: 700;
        color: #198754;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .reset-heading {
        font-size: 1.8rem;
        font-weight: 700;
        color: #0d6efd;
    }

    .reset-subtitle {
        color: #6c757d;
        font-size: 1rem;
        margin-bottom: 0;
    }

    .reset-icon {
        width: 72px;
        height: 72px;
        object-fit: contain;
    }

    .inner-form-card {
        border: 0;
        border-radius: 22px;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
        background: #ffffff;
        padding: 1.5rem;
    }

    .form-label {
        font-weight: 600;
    }

    .form-control {
        border-radius: 14px;
        padding: 0.9rem 1rem;
        border: 1px solid #dbe4f0;
    }

        .form-control:focus {
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.12);
            border-color: #86b7fe;
        }

    .reset-btn {
        border-radius: 14px;
        padding: 0.9rem 1rem;
        font-weight: 600;
        font-size: 1.05rem;
    }

    .slide-image {
        max-height: 470px;
        width: 100%;
        object-fit: cover;
        border-radius: 22px;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.14);
        transition: opacity 0.7s ease-in-out;
    }

    .right-caption {
        margin-top: 1.25rem;
    }

        .right-caption h4 {
            font-weight: 700;
            color: #198754;
            margin-bottom: 0.5rem;
        }

        .right-caption p {
            color: #6b7280;
            margin-bottom: 0;
        }

    .video-section {
        margin-top: 2rem;
    }

    .video-card {
        background: #ffffff;
        border: 0;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 14px 36px rgba(0,0,0,0.10);
    }

        .video-card video {
            width: 100%;
            display: block;
            max-height: 420px;
            object-fit: cover;
        }

    .video-caption {
        padding: 16px 20px;
        background: linear-gradient(90deg, #198754, #0d6efd);
        color: #ffffff;
        font-weight: 600;
        text-align: center;
    }

    @@media (max-width: 991px) {
        .reset-left,
        .reset-right {
            padding: 2rem;
        }

        .reset-right {
            min-height: 400px;
        }

        .slide-image {
            max-height: 320px;
        }

        .video-card video {
            max-height: 300px;
        }
    }

    @@media (max-width: 767px) {
        .reset-wrapper {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }

        .reset-card {
            border-radius: 20px;
        }

        .reset-left,
        .reset-right {
            padding: 1.25rem;
        }

        .main-title {
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        .reset-heading {
            font-size: 1.4rem;
        }

        .reset-subtitle {
            font-size: 0.95rem;
        }

        .reset-right {
            min-height: auto;
        }

        .inner-form-card {
            border-radius: 18px;
            padding: 1rem;
        }

        .slide-image {
            max-height: 240px;
            border-radius: 16px;
        }

        .form-control {
            font-size: 0.95rem;
            padding: 0.8rem 0.9rem;
        }

        .reset-btn {
            font-size: 1rem;
        }

        .video-card {
            border-radius: 18px;
        }

            .video-card video {
                max-height: 220px;
            }

        .video-caption {
            font-size: 0.95rem;
            padding: 12px 14px;
        }
    }
</style>

<div class="container reset-wrapper py-4 py-md-5">

    <h2 class="main-title">Jangiligonda Village App – Development</h2>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">
            <div class="card reset-card">
                <div class="row g-0">

                    <!-- LEFT SIDE RESET FORM -->
                    <div class="col-lg-6 reset-left">

                        <div class="text-center mb-3">
                            <img src="https://cdn-icons-png.flaticon.com/512/3064/3064155.png"
                                 alt="Reset Password"
                                 class="reset-icon" />
                        </div>

                        <div class="text-center mb-4">
                            <h3 class="reset-heading mb-2">Reset Password</h3>
                            <p class="reset-subtitle mb-0">
                                Create a new secure password for your account.
                            </p>
                        </div>

                        <div class="inner-form-card">
                            <form asp-action="ResetPasswordByPhone" method="post">

                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <div class="mb-3">
                                    <label asp-for="NewPassword" class="form-label">New Password</label>
                                    <input asp-for="NewPassword"
                                           type="password"
                                           class="form-control"
                                           placeholder="Enter New Password" />
                                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                                    <input asp-for="ConfirmPassword"
                                           type="password"
                                           class="form-control"
                                           placeholder="Confirm Password" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                </div>

                                <button type="submit" class="btn btn-success reset-btn w-100">
                                    Reset Password
                                </button>
                            </form>
                        </div>

                    </div>

                    <!-- RIGHT SIDE IMAGE SLIDESHOW -->
                    <div class="col-lg-6 d-flex align-items-center justify-content-center reset-right">
                        <div class="text-center w-100">
                            <img id="resetSlide"
                                 class="img-fluid slide-image"
                                 alt="Village Slideshow" />

                            <div class="right-caption">
                                <h4>Secure Account Recovery</h4>
                                <p>Reset your password safely and continue using the village app with confidence.</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- VILLAGE VIDEO BELOW PAGE -->
            <div class="video-section">
                <div class="video-card">
                    <video autoplay muted loop playsinline>
                        <source src="https://cdn.coverr.co/videos/coverr-rural-landscape-1579/1080p.mp4"
                                type="video/mp4">
                    </video>

                    <div class="video-caption">
                        Jangiligonda Village – Rural Life, Growth, and Digital Access
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    const images = [
        "https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=900&q=80",
        "https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=900&q=80",
        "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=900&q=80",
        "https://images.unsplash.com/photo-1502082553048-f009c37129b9?auto=format&fit=crop&w=900&q=80"
    ];

    let index = 0;
    const resetSlide = document.getElementById("resetSlide");

    function changeImage() {
        resetSlide.style.opacity = 0.25;

        setTimeout(() => {
            resetSlide.src = images[index];
            resetSlide.style.opacity = 1;

            index++;
            if (index >= images.length) {
                index = 0;
            }
        }, 250);
    }

    changeImage();
    setInterval(changeImage, 3000);
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}