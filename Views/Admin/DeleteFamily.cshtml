@model MyVillageApp.Domain.Families.Family

@{

    ViewData["Title"] = "Delete Family";
}

<div class="container mt-5">

    <div class="card shadow-lg p-4 rounded">

        <h2 class="text-danger mb-4">Delete Family</h2>

        <h5>Are you sure you want to delete this Family?</h5>

        <hr />

        <div class="mb-3">
            <strong>Family OwnerName:</strong>
            <span class="text-primary">@Model.OwnerName</span>
        </div>

        <form asp-action="DeleteFamilyConfirmed" method="post">

            <input type="hidden" name="id" value="@Model.Id" />

            <button type="submit" class="btn btn-danger me-2">
                Yes, Delete
            </button>

            <a asp-action="Families" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>