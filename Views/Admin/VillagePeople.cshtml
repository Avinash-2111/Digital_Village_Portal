@model MyVillageApp.Models.Admin.VillagePeopleFilterModel

@{
 
    ViewData["Title"] = "Village People";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .people-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .people-title {
        font-size: 34px;
        font-weight: 700;
        color: #198754;
        margin-bottom: 6px;
    }

    .people-subtitle {
        color: #6c757d;
        margin-bottom: 0;
    }

    .top-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .page-btn {
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 16px;
    }

    .people-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 20px;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-radius: 12px;
    }

    .people-table {
        min-width: 1500px;
        margin-bottom: 0;
    }

        .people-table thead th {
            background: #198754;
            color: #fff;
            text-align: center;
            white-space: nowrap;
            font-size: 14px;
            vertical-align: middle;
        }

        .people-table tbody td {
            white-space: nowrap;
            font-size: 14px;
            vertical-align: middle;
        }

    .count-badge {
        background: #e9f7ef;
        color: #198754;
        border-radius: 12px;
        padding: 8px 14px;
        font-weight: 600;
        display: inline-block;
        margin-bottom: 16px;
    }

    .pagination-wrap {
        display: flex;
        justify-content: center;
        margin-top: 20px;
        flex-wrap: wrap;
        gap: 6px;
    }

        .pagination-wrap .btn {
            min-width: 42px;
            border-radius: 8px;
        }

    .gender-box {
        display: flex;
        gap: 16px;
        align-items: center;
        flex-wrap: wrap;
        padding-top: 8px;
    }

    @@media (max-width: 1200px) {
        .filter-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .people-title {
            font-size: 26px;
        }

        .people-subtitle {
            font-size: 14px;
        }

        .top-actions {
            width: 100%;
        }

            .top-actions a {
                flex: 1 1 100%;
                text-align: center;
            }

        .filter-grid {
            grid-template-columns: 1fr;
        }

        .people-card {
            padding: 14px !important;
        }

        .people-table thead th,
        .people-table tbody td {
            font-size: 13px;
            padding: 10px 8px;
        }
    }
</style>

<div class="container-fluid mt-4 px-3">

    <div class="people-page-header">
        <div>
            <h1 class="people-title">Village People</h1>
            <p class="people-subtitle">Search and filter all village family members</p>
        </div>

        <div class="top-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success page-btn">
                <i class="bi bi-house-door-fill me-2"></i>Back to Home
            </a>

            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-primary page-btn">
                <i class="bi bi-speedometer2 me-2"></i>Back to Admin Dashboard
            </a>
        </div>
    </div>

    <div class="people-card p-4 bg-white">

        <div class="count-badge">
            Total People: @Model.TotalCount
        </div>

        <form method="get" asp-action="VillagePeople">

            <div class="filter-grid">

                <div>
                    <label class="form-label fw-semibold">Member Name</label>
                    <input type="text" name="searchText" value="@Model.SearchText" class="form-control" placeholder="Search by member name" />
                </div>

                <div>
                    <label class="form-label fw-semibold">Owner Name</label>
                    <input type="text" name="ownerName" value="@Model.OwnerName" class="form-control" placeholder="Search by owner name" />
                </div>

                <div>
                    <label class="form-label fw-semibold">Profession</label>
                    <select name="professionId" class="form-select">
                        <option value="">Select Profession</option>
                        @foreach (var item in Model.AvailableProfessions)
                        {
                            if (Model.ProfessionId.HasValue && Model.ProfessionId.Value.ToString() == item.Value)
                            {
                                <option value="@item.Value" selected>@item.Text</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label fw-semibold">Scheme</label>
                    <select name="schemeId" class="form-select">
                        <option value="">Select Scheme</option>
                        @foreach (var item in Model.AvailableSchemes)
                        {
                            if (Model.SchemeId.HasValue && Model.SchemeId.Value.ToString() == item.Value)
                            {
                                <option value="@item.Value" selected>@item.Text</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label fw-semibold">Pension</label>
                    <select name="pensionId" class="form-select">
                        <option value="">Select Pension</option>
                        @foreach (var item in Model.AvailablePensions)
                        {
                            if (Model.PensionId.HasValue && Model.PensionId.Value.ToString() == item.Value)
                            {
                                <option value="@item.Value" selected>@item.Text</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label fw-semibold">Vehicle Type</label>
                    <select name="vehicleTypeId" class="form-select">
                        <option value="">Select Vehicle Type</option>
                        @foreach (var item in Model.AvailableVehicleTypes)
                        {
                            if (Model.VehicleTypeId.HasValue && Model.VehicleTypeId.Value.ToString() == item.Value)
                            {
                                <option value="@item.Value" selected>@item.Text</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label fw-semibold">Gender</label>
                    <div class="gender-box">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="male" value="true" @(Model.Male ? "checked" : "") />
                            <label class="form-check-label">Male</label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="female" value="true" @(Model.Female ? "checked" : "") />
                            <label class="form-check-label">Female</label>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="form-label fw-semibold">Disabled</label>
                    <select name="isDisabled" class="form-select">
                        <option value="">All</option>
                        @if (Model.IsDisabled == true)
                        {
                            <option value="true" selected>Yes</option>
                            <option value="false">No</option>
                        }
                        else if (Model.IsDisabled == false)
                        {
                            <option value="true">Yes</option>
                            <option value="false" selected>No</option>
                        }
                        else
                        {
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label fw-semibold">Married</label>
                    <select name="isMarried" class="form-select">
                        <option value="">All</option>
                        @if (Model.IsMarried == true)
                        {
                            <option value="true" selected>Yes</option>
                            <option value="false">No</option>
                        }
                        else if (Model.IsMarried == false)
                        {
                            <option value="true">Yes</option>
                            <option value="false" selected>No</option>
                        }
                        else
                        {
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        }
                    </select>
                </div>

            </div>

            <div class="d-flex gap-2 flex-wrap mb-4">
                <button type="submit" class="btn btn-primary page-btn">
                    <i class="bi bi-search me-1"></i>Search
                </button>

                <a asp-action="VillagePeople" class="btn btn-secondary page-btn">
                    <i class="bi bi-arrow-clockwise me-1"></i>Reset
                </a>
            </div>
        </form>

        @if (Model.Results == null || !Model.Results.Any())
        {
            <div class="alert alert-warning mb-0">
                No village people found.
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-bordered table-striped align-middle people-table">
                    <thead>
                        <tr>
                            <th>Family Id</th>
                            <th>Owner Name</th>
                            <th>Member Name</th>
                            <th>Aadhaar Number</th>
                            <th>Phone Number</th>
                            <th>Gender</th>
                            <th>Professions</th>
                            <th>Schemes</th>
                            <th>Pensions</th>
                            <th>Vehicle Types</th>
                            <th>Disabled</th>
                            <th>Married</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Results)
                        {
                            var maskedPhone = string.IsNullOrWhiteSpace(item.PhoneNumber) || item.PhoneNumber.Length < 4
                            ? item.PhoneNumber
                            : "XXXXXX" + item.PhoneNumber.Substring(item.PhoneNumber.Length - 4);

                            var maskedAadhaar = string.IsNullOrWhiteSpace(item.AadhaarNumber) || item.AadhaarNumber.Length < 4
                            ? item.AadhaarNumber
                            : "XXXXXXXX" + item.AadhaarNumber.Substring(item.AadhaarNumber.Length - 4);

                            <tr>
                                <td>@item.FamilyId</td>
                                <td>@item.FamilyOwnerName</td>
                                <td>@item.Name</td>
                                <td>@maskedAadhaar</td>
                                <td>@maskedPhone</td>
                                <td>@item.Gender</td>
                                <td>@item.Professions</td>
                                <td>@item.Schemes</td>
                                <td>@item.Pensions</td>
                                <td>@item.VehicleTypes</td>
                                <td>@(item.IsPhysicallyDisabled ? "Yes" : "No")</td>
                                <td>@(item.IsMarried ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="pagination-wrap">
                    <a asp-action="VillagePeople"
                       asp-route-searchText="@Model.SearchText"
                       asp-route-ownerName="@Model.OwnerName"
                       asp-route-professionId="@Model.ProfessionId"
                       asp-route-schemeId="@Model.SchemeId"
                       asp-route-pensionId="@Model.PensionId"
                       asp-route-vehicleTypeId="@Model.VehicleTypeId"
                       asp-route-male="@Model.Male"
                       asp-route-female="@Model.Female"
                       asp-route-isDisabled="@Model.IsDisabled"
                       asp-route-isMarried="@Model.IsMarried"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       class="btn btn-outline-secondary @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <i class="bi bi-chevron-left"></i>
                    </a>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <a asp-action="VillagePeople"
                           asp-route-searchText="@Model.SearchText"
                           asp-route-ownerName="@Model.OwnerName"
                           asp-route-professionId="@Model.ProfessionId"
                           asp-route-schemeId="@Model.SchemeId"
                           asp-route-pensionId="@Model.PensionId"
                           asp-route-vehicleTypeId="@Model.VehicleTypeId"
                           asp-route-male="@Model.Male"
                           asp-route-female="@Model.Female"
                           asp-route-isDisabled="@Model.IsDisabled"
                           asp-route-isMarried="@Model.IsMarried"
                           asp-route-page="@i"
                           class="btn @(i == Model.CurrentPage ? "btn-success" : "btn-outline-success")">
                            @i
                        </a>
                    }

                    <a asp-action="VillagePeople"
                       asp-route-searchText="@Model.SearchText"
                       asp-route-ownerName="@Model.OwnerName"
                       asp-route-professionId="@Model.ProfessionId"
                       asp-route-schemeId="@Model.SchemeId"
                       asp-route-pensionId="@Model.PensionId"
                       asp-route-vehicleTypeId="@Model.VehicleTypeId"
                       asp-route-male="@Model.Male"
                       asp-route-female="@Model.Female"
                       asp-route-isDisabled="@Model.IsDisabled"
                       asp-route-isMarried="@Model.IsMarried"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       class="btn btn-outline-secondary @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            }
        }

    </div>
</div>