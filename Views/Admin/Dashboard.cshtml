@{
  
    ViewData["Title"] = "Admin Dashboard";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

    .dashboard-title {
        font-size: 38px;
        font-weight: 700;
        color: #198754;
        text-align: center;
        margin-bottom: 10px;
    }

    .dashboard-subtitle {
        text-align: center;
        font-size: 18px;
        color: #6c757d;
        margin-bottom: 35px;
    }

    .dashboard-card {
        border: none;
        border-radius: 18px;
        transition: all 0.3s ease;
        overflow: hidden;
        min-height: 190px;
    }

        .dashboard-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(0,0,0,0.15);
        }

    .dashboard-link {
        text-decoration: none;
        display: block;
    }

    .dashboard-icon {
        font-size: 42px;
        margin-bottom: 12px;
        display: inline-block;
    }

    .dashboard-card h4 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .dashboard-card p {
        margin-bottom: 0;
        color: #555;
        font-size: 15px;
    }

    .bg-soft-users {
        background: linear-gradient(135deg, #e8fff3, #d9f7ea);
    }

    .bg-soft-schemes {
        background: linear-gradient(135deg, #eaf3ff, #dbeafe);
    }

    .bg-soft-professions {
        background: linear-gradient(135deg, #eefbff, #d9f4ff);
    }

    .bg-soft-leaders {
        background: linear-gradient(135deg, #fff0f0, #ffe1e1);
    }

    .bg-soft-gallery {
        background: linear-gradient(135deg, #f3f0ff, #e7ddff);
    }

    .bg-soft-pensions {
        background: linear-gradient(135deg, #fff8e6, #ffefbf);
    }

    .bg-soft-families {
        background: linear-gradient(135deg, #edfff1, #d8f8df);
    }

    .bg-soft-vehicles {
        background: linear-gradient(135deg, #f5f5f5, #e9ecef);
    }

    .bg-soft-people {
        background: linear-gradient(135deg, #eef4ff, #dde8ff);
    }

    .bg-soft-pets {
        background: linear-gradient(135deg, #fff4e8, #ffe7cc);
    }

    .icon-users {
        color: #198754;
    }

    .icon-schemes {
        color: #0d6efd;
    }

    .icon-professions {
        color: #0dcaf0;
    }

    .icon-leaders {
        color: #dc3545;
    }

    .icon-gallery {
        color: #6f42c1;
    }

    .icon-pensions {
        color: #fd7e14;
    }

    .icon-families {
        color: #20c997;
    }

    .icon-vehicles {
        color: #343a40;
    }

    .icon-people {
        color: #3b5bdb;
    }

    .icon-pets {
        color: #d97706;
    }

    .home-btn {
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
    }

    @@media (max-width: 767px) {
        .dashboard-title {
            font-size: 28px;
        }

        .dashboard-subtitle {
            font-size: 15px;
            margin-bottom: 25px;
        }

        .dashboard-card {
            min-height: auto;
        }

        .dashboard-header {
            flex-direction: column;
            align-items: stretch;
        }

        .home-btn {
            width: 100%;
        }
    }
</style>

<div class="container mt-4">

    <div class="dashboard-header">
        <div>
            <h1 class="dashboard-title mb-1">Welcome to Jangiligonda Village Admin Site</h1>
            <p class="dashboard-subtitle mb-0">Manage village data easily from one beautiful dashboard</p>
        </div>

        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success home-btn">
                <i class="bi bi-house-door-fill me-2"></i>Back to Home
            </a>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Admin" asp-action="Users" class="dashboard-link">
                <div class="card dashboard-card bg-soft-users shadow-sm text-center p-4">
                    <i class="bi bi-people-fill dashboard-icon icon-users"></i>
                    <h4 class="text-success">Users</h4>
                    <p>Manage registered users and roles</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Admin" asp-action="Schemes" class="dashboard-link">
                <div class="card dashboard-card bg-soft-schemes shadow-sm text-center p-4">
                    <i class="bi bi-journal-text dashboard-icon icon-schemes"></i>
                    <h4 class="text-primary">Schemes</h4>
                    <p>Manage village schemes and benefits</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Admin" asp-action="Professions" class="dashboard-link">
                <div class="card dashboard-card bg-soft-professions shadow-sm text-center p-4">
                    <i class="bi bi-briefcase-fill dashboard-icon icon-professions"></i>
                    <h4 class="text-info">Professions</h4>
                    <p>Manage profession categories</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Admin" asp-action="Leaders" class="dashboard-link">
                <div class="card dashboard-card bg-soft-leaders shadow-sm text-center p-4">
                    <i class="bi bi-person-badge-fill dashboard-icon icon-leaders"></i>
                    <h4 class="text-danger">Leader Information</h4>
                    <p>Manage village leader details</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Admin" asp-action="VillageGallery" class="dashboard-link">
                <div class="card dashboard-card bg-soft-gallery shadow-sm text-center p-4">
                    <i class="bi bi-images dashboard-icon icon-gallery"></i>
                    <h4 class="text-secondary">Village Gallery</h4>
                    <p>Manage village photos and videos</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Admin" asp-action="Pensions" class="dashboard-link">
                <div class="card dashboard-card bg-soft-pensions shadow-sm text-center p-4">
                    <i class="bi bi-cash-coin dashboard-icon icon-pensions"></i>
                    <h4 class="text-warning">Pensions</h4>
                    <p>Manage pension beneficiary details</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Admin" asp-action="Families" class="dashboard-link">
                <div class="card dashboard-card bg-soft-families shadow-sm text-center p-4">
                    <i class="bi bi-house-heart-fill dashboard-icon icon-families"></i>
                    <h4 class="text-success">Families</h4>
                    <p>Manage village family information</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Admin" asp-action="VillagePeople" class="dashboard-link">
                <div class="card dashboard-card bg-soft-people shadow-sm text-center p-4">
                    <i class="bi bi-person-lines-fill dashboard-icon icon-people"></i>
                    <h4 class="text-primary">Village People</h4>
                    <p>View all family members in village</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Admin" asp-action="VehicleTypes" class="dashboard-link">
                <div class="card dashboard-card bg-soft-vehicles shadow-sm text-center p-4">
                    <i class="bi bi-truck-front-fill dashboard-icon icon-vehicles"></i>
                    <h4 class="text-dark">Vehicle Types</h4>
                    <p>Manage available vehicle categories</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Admin" asp-action="Pets" class="dashboard-link">
                <div class="card dashboard-card bg-soft-pets shadow-sm text-center p-4">
                    <i class="bi bi-heart-fill dashboard-icon icon-pets"></i>
                    <h4 style="color:#d97706;">Pets</h4>
                    <p>Manage village pet types</p>
                </div>
            </a>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Admin" asp-action="Wishes" class="dashboard-link">
                <div class="card dashboard-card bg-soft-gallery shadow-sm text-center p-4">
                    <i class="bi bi-gift-fill dashboard-icon icon-gallery"></i>
                    <h4 class="text-primary">Wishes Convey</h4>
                    <p>Manage wishes with multiple photos/videos</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Admin" asp-action="Celebrations" class="dashboard-link">
                <div class="card dashboard-card bg-soft-pensions shadow-sm text-center p-4">
                    <i class="bi bi-balloon-fill dashboard-icon icon-pensions"></i>
                    <h4 class="text-warning">Celebrations</h4>
                    <p>Manage celebration items</p>
                </div>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <a asp-controller="Admin" asp-action="Announcements" class="dashboard-link">
                <div class="card dashboard-card bg-soft-people shadow-sm text-center p-4">
                    <i class="bi bi-megaphone-fill dashboard-icon icon-people"></i>
                    <h4 class="text-danger">Announcements</h4>
                    <p>Manage public announcements</p>
                </div>
            </a>
        </div>

    </div>
</div>