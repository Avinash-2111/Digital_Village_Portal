@model List<MyVillageApp.Models.Admin.FamilyMemberListModel>

@{
   
    ViewData["Title"] = "Family Members";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .familymembers-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .familymembers-title {
        font-size: 34px;
        font-weight: 700;
        color: #198754;
        margin-bottom: 6px;
    }

    .familymembers-subtitle {
        color: #6c757d;
        margin-bottom: 0;
    }

    .top-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .page-btn {
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 16px;
    }

    .familymembers-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .search-bar-wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .search-form {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        width: 100%;
        max-width: 700px;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-radius: 12px;
    }

    .member-table {
        min-width: 1400px;
        margin-bottom: 0;
    }

        .member-table thead th {
            background: #198754;
            color: #fff;
            vertical-align: middle;
            text-align: center;
            white-space: nowrap;
            font-size: 14px;
        }

        .member-table tbody td {
            vertical-align: middle;
            white-space: nowrap;
            font-size: 14px;
        }

    .pagination-wrap {
        display: flex;
        justify-content: center;
        margin-top: 20px;
        flex-wrap: wrap;
        gap: 6px;
    }

        .pagination-wrap .btn {
            min-width: 42px;
            border-radius: 8px;
        }

    .count-badge {
        background: #e9f7ef;
        color: #198754;
        border-radius: 12px;
        padding: 8px 14px;
        font-weight: 600;
    }

    .owner-highlight {
        color: #0d6efd;
        font-weight: 700;
    }

    @@media (max-width: 768px) {
        .familymembers-title {
            font-size: 26px;
        }

        .familymembers-subtitle {
            font-size: 14px;
        }

        .top-actions {
            width: 100%;
        }

            .top-actions a {
                flex: 1 1 100%;
                text-align: center;
            }

        .search-form {
            max-width: 100%;
        }

            .search-form input,
            .search-form button,
            .search-form a {
                width: 100%;
            }

        .count-badge {
            width: 100%;
            text-align: center;
        }

        .familymembers-card {
            padding: 14px !important;
        }

        .member-table thead th,
        .member-table tbody td {
            font-size: 13px;
            padding: 10px 8px;
        }
    }
</style>

<div class="container-fluid mt-4 px-3">

    <div class="familymembers-page-header">
        <div>
            <h1 class="familymembers-title">Family Members</h1>
            <p class="familymembers-subtitle">
                Family Members of <span class="owner-highlight">@ViewBag.OwnerName</span>
            </p>
        </div>

        <div class="top-actions">
            <a asp-controller="Admin"
               asp-action="Families"
               class="btn btn-outline-success page-btn">
                <i class="bi bi-arrow-left-circle me-2"></i>Back to Families
            </a>

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="btn btn-outline-primary page-btn">
                <i class="bi bi-speedometer2 me-2"></i>Back to Admin Dashboard
            </a>
        </div>
    </div>

    <div class="familymembers-card p-4 bg-white">

        <div class="search-bar-wrap">
            <form method="get" asp-action="FamilyMembers" class="search-form">
                <input type="hidden" name="familyId" value="@ViewBag.FamilyId" />

                <input type="text"
                       name="searchText"
                       value="@ViewBag.SearchText"
                       class="form-control"
                       placeholder="Search by member name" />

                <button type="submit" class="btn btn-primary page-btn">
                    <i class="bi bi-search me-1"></i>Search
                </button>

                <a asp-action="FamilyMembers"
                   asp-route-familyId="@ViewBag.FamilyId"
                   class="btn btn-secondary page-btn">
                    <i class="bi bi-arrow-clockwise me-1"></i>Reset
                </a>

                <a asp-action="CreateFamilyMember"
                   asp-route-familyId="@ViewBag.FamilyId"
                   class="btn btn-success page-btn">
                    <i class="bi bi-plus-circle me-1"></i>Create New
                </a>
            </form>

            <div class="count-badge">
                Total Members: @(Model?.Count ?? 0)
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-warning mb-0">
                No family members found.
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-bordered table-striped align-middle member-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Aadhaar</th>
                            <th>Phone</th>
                            <th>Gender</th>
                            <th>Professions</th>
                            <th>Schemes</th>
                            <th>Pensions</th>
                            <th>Vehicle Types</th>
                            <th>Disabled</th>
                            <th>Married</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.AadhaarNumber</td>
                                <td>@item.PhoneNumber</td>
                                <td>@item.Gender</td>
                                <td>@item.Professions</td>
                                <td>@item.Schemes</td>
                                <td>@item.Pensions</td>
                                <td>@item.VehicleTypes</td>
                                <td>@(item.IsPhysicallyDisabled ? "Yes" : "No")</td>
                                <td>@(item.IsMarried ? "Yes" : "No")</td>
                                <td>
                                    <a asp-action="EditFamilyMember"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm mb-1">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </a>

                                    <a asp-action="DeleteFamilyMember"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm mb-1">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>