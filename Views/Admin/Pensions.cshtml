@model List<MyVillageApp.Domain.Pensions.Pension>
  

    @{
     
        ViewData["Title"] = "Pensions";
    }

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        .pensions-page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .pensions-title {
            font-size: 34px;
            font-weight: 700;
            color: #198754;
            margin-bottom: 6px;
        }

        .pensions-subtitle {
            color: #6c757d;
            margin-bottom: 0;
        }

        .top-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .page-btn {
            border-radius: 10px;
            font-weight: 600;
            padding: 10px 16px;
        }

        .pensions-card {
            border: none;
            border-radius: 18px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-radius: 12px;
        }

        .pensions-table {
            min-width: 700px;
            margin-bottom: 0;
        }

            .pensions-table thead th {
                background: #198754;
                color: #fff;
                text-align: center;
                vertical-align: middle;
                white-space: nowrap;
                font-size: 14px;
            }

            .pensions-table tbody td {
                vertical-align: middle;
                white-space: nowrap;
                font-size: 14px;
            }

        .empty-box {
            background: #fff3cd;
            color: #856404;
            border-radius: 12px;
            padding: 14px 16px;
            font-weight: 600;
        }

        @@media (max-width: 768px) {
            .pensions-title {
                font-size: 26px;
            }

            .pensions-subtitle {
                font-size: 14px;
            }

            .top-actions {
                width: 100%;
            }

                .top-actions a {
                    flex: 1 1 100%;
                    text-align: center;
                }

            .pensions-card {
                padding: 14px !important;
            }

            .pensions-table thead th,
            .pensions-table tbody td {
                font-size: 13px;
                padding: 10px 8px;
            }
        }
    </style>

    <div class="container-fluid mt-4 px-3">

        <div class="pensions-page-header">
            <div>
                <h1 class="pensions-title">Pensions</h1>
                <p class="pensions-subtitle">Manage pension names and amounts</p>
            </div>

            <div class="top-actions">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success page-btn">
                    <i class="bi bi-house-door-fill me-2"></i>Back to Home
                </a>

                <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-primary page-btn">
                    <i class="bi bi-speedometer2 me-2"></i>Back to Admin Dashboard
                </a>

                <a asp-action="CreatePension" class="btn btn-success page-btn">
                    <i class="bi bi-plus-circle me-2"></i>Create New
                </a>
            </div>
        </div>

        <div class="pensions-card p-4 bg-white">

            @if (Model == null || !Model.Any())
            {
                <div class="empty-box">
                    No pension records found
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="table table-bordered table-striped align-middle pensions-table">
                        <thead>
                            <tr>
                                <th>Pension Name</th>
                                <th>Amount</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Amount</td>
                                    <td>
                                        <a asp-action="EditPension"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm mb-1">
                                            <i class="bi bi-pencil-square me-1"></i>Edit
                                        </a>

                                        <a asp-action="DeletePension"
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm mb-1">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
