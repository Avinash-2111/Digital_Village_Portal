@model List<MyVillageApp.Domain.Leaders.Leader>

@{
    
    ViewData["Title"] = "Leader Information";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .leaders-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .leaders-title {
        font-size: 34px;
        font-weight: 700;
        color: #198754;
        margin-bottom: 6px;
    }

    .leaders-subtitle {
        color: #6c757d;
        margin-bottom: 0;
    }

    .top-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .page-btn {
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 16px;
    }

    .leaders-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-radius: 12px;
    }

    .leaders-table {
        min-width: 900px;
        margin-bottom: 0;
    }

        .leaders-table thead th {
            background: #198754;
            color: #fff;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
            font-size: 14px;
        }

        .leaders-table tbody td {
            vertical-align: middle;
            white-space: nowrap;
            font-size: 14px;
        }

    .leader-photo {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 12px;
        border: 2px solid #e9ecef;
        background: #f8f9fa;
    }

    .empty-box {
        background: #fff3cd;
        color: #856404;
        border-radius: 12px;
        padding: 14px 16px;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .leaders-title {
            font-size: 26px;
        }

        .leaders-subtitle {
            font-size: 14px;
        }

        .top-actions {
            width: 100%;
        }

            .top-actions a {
                flex: 1 1 100%;
                text-align: center;
            }

        .leaders-card {
            padding: 14px !important;
        }

        .leaders-table thead th,
        .leaders-table tbody td {
            font-size: 13px;
            padding: 10px 8px;
        }

        .leader-photo {
            width: 60px;
            height: 60px;
        }
    }
</style>

<div class="container-fluid mt-4 px-3">

    <div class="leaders-page-header">
        <div>
            <h1 class="leaders-title">Leader Information</h1>
            <p class="leaders-subtitle">Manage village leadership details and photos</p>
        </div>

        <div class="top-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success page-btn">
                <i class="bi bi-house-door-fill me-2"></i>Back to Home
            </a>

            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-primary page-btn">
                <i class="bi bi-speedometer2 me-2"></i>Back to Admin Dashboard
            </a>

            <a asp-action="CreateLeader" class="btn btn-success page-btn">
                <i class="bi bi-plus-circle me-2"></i>Create New
            </a>
        </div>
    </div>

    <div class="leaders-card p-4 bg-white">

        @if (Model == null || !Model.Any())
        {
            <div class="empty-box">
                No leaders available
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-bordered table-striped align-middle leaders-table">
                    <thead>
                        <tr>
                            <th>Photo</th>
                            <th>Name</th>
                            <th>Role</th>
                            <th>Ward Name</th>
                            <th>Ward Number</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    @if (!string.IsNullOrWhiteSpace(item.Photo))
                                    {
                                        <img src="/leaderphotos/@item.Photo"
                                             alt="@item.Name"
                                             class="leader-photo" />
                                    }
                                    else
                                    {
                                        <img src="https://via.placeholder.com/70x70?text=No+Image"
                                             alt="No Image"
                                             class="leader-photo" />
                                    }
                                </td>

                                <td>@item.Name</td>
                                <td>@item.VillageRole</td>
                                <td>@(item.WardName ?? "-")</td>
                                <td>@(item.WardNumber.ToString() ??"_")</td>
                                <td>
                                    <a asp-action="EditLeader"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm mb-1">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </a>

                                    <a asp-action="DeleteLeader"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm mb-1">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>