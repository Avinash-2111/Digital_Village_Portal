@model List<MyVillageApp.Domain.Gallery.VillageGallery>

@{
    
    ViewData["Title"] = "Village Gallery";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .gallery-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .gallery-title {
        font-size: 34px;
        font-weight: 700;
        color: #198754;
        margin-bottom: 6px;
    }

    .gallery-subtitle {
        color: #6c757d;
        margin-bottom: 0;
    }

    .top-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .page-btn {
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 16px;
    }

    .gallery-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-radius: 12px;
    }

    .gallery-table {
        min-width: 1000px;
        margin-bottom: 0;
    }

        .gallery-table thead th {
            background: #198754;
            color: #fff;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
            font-size: 14px;
        }

        .gallery-table tbody td {
            vertical-align: middle;
            white-space: nowrap;
            font-size: 14px;
        }

    .gallery-preview-img,
    .gallery-preview-video {
        width: 120px;
        height: 80px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        background: #f8f9fa;
    }

    .empty-box {
        background: #fff3cd;
        color: #856404;
        border-radius: 12px;
        padding: 14px 16px;
        font-weight: 600;
    }

    .desc-cell {
        white-space: normal !important;
        min-width: 220px;
        max-width: 300px;
    }

    @@media (max-width: 768px) {
        .gallery-title {
            font-size: 26px;
        }

        .gallery-subtitle {
            font-size: 14px;
        }

        .top-actions {
            width: 100%;
        }

            .top-actions a {
                flex: 1 1 100%;
                text-align: center;
            }

        .gallery-card {
            padding: 14px !important;
        }

        .gallery-table thead th,
        .gallery-table tbody td {
            font-size: 13px;
            padding: 10px 8px;
        }

        .gallery-preview-img,
        .gallery-preview-video {
            width: 100px;
            height: 70px;
        }
    }
</style>

<div class="container-fluid mt-4 px-3">

    <div class="gallery-page-header">
        <div>
            <h1 class="gallery-title">Village Gallery</h1>
            <p class="gallery-subtitle">Manage village photos and videos</p>
        </div>

        <div class="top-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success page-btn">
                <i class="bi bi-house-door-fill me-2"></i>Back to Home
            </a>

            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-primary page-btn">
                <i class="bi bi-speedometer2 me-2"></i>Back to Admin Dashboard
            </a>

            <a asp-action="CreateVillageGallery" class="btn btn-success page-btn">
                <i class="bi bi-plus-circle me-2"></i>Create New
            </a>
        </div>
    </div>

    <div class="gallery-card p-4 bg-white">

        @if (Model == null || !Model.Any())
        {
            <div class="empty-box">
                No gallery items available
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-bordered table-striped align-middle gallery-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Media Type</th>
                            <th>Preview</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.MediaType</td>
                                <td class="text-center">
                                    @if (item.MediaType == "Photo" && !string.IsNullOrEmpty(item.FileName))
                                    {
                                        <img src="~/villagegallery/@item.FileName"
                                             class="gallery-preview-img"
                                             alt="@item.Title" />
                                    }
                                    else if (item.MediaType == "Video" && !string.IsNullOrEmpty(item.FileName))
                                    {
                                        <video class="gallery-preview-video" controls>
                                            <source src="~/villagegallery/@item.FileName" type="video/mp4" />
                                        </video>
                                    }
                                    else
                                    {
                                        <span>No File</span>
                                    }
                                </td>
                                <td class="desc-cell">@item.Description</td>
                                <td>
                                    <a asp-action="EditVillageGallery"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm me-1 mb-1">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </a>

                                    <a asp-action="DeleteVillageGallery"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm mb-1">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>