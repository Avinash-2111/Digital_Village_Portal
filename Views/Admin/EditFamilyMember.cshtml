@model MyVillageApp.Models.Admin.FamilyMemberModel

@{
  
    ViewData["Title"] = "Edit Family Member";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .member-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .member-title {
        font-size: 34px;
        font-weight: 700;
        color: #198754;
        margin-bottom: 6px;
    }

    .member-subtitle {
        color: #6c757d;
        margin-bottom: 0;
    }

    .top-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .page-btn {
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 16px;
    }

    .member-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 12px 28px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .section-title {
        font-size: 20px;
        font-weight: 700;
        color: #0d6efd;
        margin-bottom: 16px;
    }

    .form-label {
        font-weight: 600;
        color: #374151;
    }

    .form-control,
    .form-select {
        border-radius: 12px;
        padding: 10px 12px;
        border: 1px solid #d9e2ec;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.18rem rgba(13, 110, 253, 0.12);
        }

    .multi-box {
        background: linear-gradient(135deg, #f8fbff, #f0fdf4);
        border: 1px solid #dbeafe;
        border-radius: 18px;
        padding: 16px;
        margin-bottom: 16px;
    }

    .multi-title {
        font-size: 17px;
        font-weight: 700;
        color: #198754;
        margin-bottom: 10px;
    }

    .selected-tags {
        margin-bottom: 12px;
    }

    .selected-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        color: #198754;
        border: 1px solid #cdebd8;
        border-radius: 999px;
        padding: 7px 12px;
        font-weight: 600;
        margin: 4px 6px 0 0;
        font-size: 14px;
    }

    .tag-remove {
        border: none;
        background: transparent;
        color: #dc3545;
        font-weight: 700;
        cursor: pointer;
        padding: 0;
        line-height: 1;
        font-size: 16px;
    }

    .multi-select {
        min-height: 150px;
        border-radius: 14px;
        padding: 10px;
        background: #ffffff;
    }

    .checks-wrap {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .form-check {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 10px 14px 10px 34px;
    }

    .actions-bottom {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 24px;
    }

    .submit-btn {
        border-radius: 12px;
        padding: 11px 18px;
        font-weight: 600;
        min-width: 130px;
    }

    @@media (max-width: 768px) {
        .member-title {
            font-size: 26px;
        }

        .member-subtitle {
            font-size: 14px;
        }

        .top-actions {
            width: 100%;
        }

            .top-actions a {
                flex: 1 1 100%;
                text-align: center;
            }

        .member-card {
            padding: 14px !important;
        }

        .checks-wrap {
            flex-direction: column;
            gap: 10px;
        }

        .multi-select {
            min-height: 130px;
        }

        .actions-bottom .btn {
            width: 100%;
        }
    }
</style>

<div class="container-fluid mt-4 px-3">

    <div class="member-page-header">
        <div>
            <h1 class="member-title">Edit Family Member</h1>
            <p class="member-subtitle">Update member details, selections, and status</p>
        </div>

        <div class="top-actions">
            <a asp-controller="Admin"
               asp-action="FamilyMembers"
               asp-route-familyId="@Model.FamilyId"
               class="btn btn-outline-success page-btn">
                <i class="bi bi-arrow-left-circle me-2"></i>Back to Families
            </a>

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="btn btn-outline-primary page-btn">
                <i class="bi bi-speedometer2 me-2"></i>Back to Admin Dashboard
            </a>
        </div>
    </div>

    <div class="member-card p-4 bg-white">
        <h2 class="section-title">Member Information</h2>

        <form asp-action="EditFamilyMember" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FamilyId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Enter member name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="AadhaarNumber" class="form-label">Aadhaar Number</label>
                    <input asp-for="AadhaarNumber" class="form-control" placeholder="Enter Aadhaar number" />
                    <span asp-validation-for="AadhaarNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Gender" class="form-label">Gender</label>
                    <select asp-for="Gender" class="form-select">
                        <option value="">Select Gender</option>
                        <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                        <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>
            </div>

            <!-- Professions -->
            <div class="multi-box">
                <div class="multi-title">
                    <i class="bi bi-briefcase-fill me-2"></i>Professions
                </div>

                <div class="selected-tags" id="profession-tags"></div>

                <select asp-for="SelectedProfessionIds"
                        asp-items="Model.AvailableProfessions"
                        class="form-select multi-select"
                        id="SelectedProfessionIds"
                        multiple
                        size="5">
                </select>
            </div>

            <!-- Schemes -->
            <div class="multi-box">
                <div class="multi-title">
                    <i class="bi bi-journal-text me-2"></i>Schemes
                </div>

                <div class="selected-tags" id="scheme-tags"></div>

                <select asp-for="SelectedSchemeIds"
                        asp-items="Model.AvailableSchemes"
                        class="form-select multi-select"
                        id="SelectedSchemeIds"
                        multiple
                        size="5">
                </select>
            </div>

            <!-- Pensions -->
            <div class="multi-box">
                <div class="multi-title">
                    <i class="bi bi-cash-coin me-2"></i>Pensions
                </div>

                <div class="selected-tags" id="pension-tags"></div>

                <select asp-for="SelectedPensionIds"
                        asp-items="Model.AvailablePensions"
                        class="form-select multi-select"
                        id="SelectedPensionIds"
                        multiple
                        size="5">
                </select>
            </div>

            <!-- Vehicle Types -->
            <div class="multi-box">
                <div class="multi-title">
                    <i class="bi bi-truck-front-fill me-2"></i>Vehicle Types
                </div>

                <div class="selected-tags" id="vehicletype-tags"></div>

                <select asp-for="SelectedVehicleTypeIds"
                        asp-items="Model.AvailableVehicleTypes"
                        class="form-select multi-select"
                        id="SelectedVehicleTypeIds"
                        multiple
                        size="5">
                </select>
            </div>

            <div class="checks-wrap">
                <div class="form-check">
                    <input asp-for="IsPhysicallyDisabled" class="form-check-input" />
                    <label asp-for="IsPhysicallyDisabled" class="form-check-label">Physically Disabled</label>
                </div>

                <div class="form-check">
                    <input asp-for="IsMarried" class="form-check-input" />
                    <label asp-for="IsMarried" class="form-check-label">Married</label>
                </div>
            </div>

            <div class="actions-bottom">
                <button type="submit" class="btn btn-primary submit-btn">
                    <i class="bi bi-check-circle me-1"></i>Update
                </button>

                <a asp-action="FamilyMembers"
                   asp-route-familyId="@Model.FamilyId"
                   class="btn btn-secondary submit-btn">
                    <i class="bi bi-arrow-left-circle me-1"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function renderSelectedTags(selectId, tagContainerId) {
            const select = document.getElementById(selectId);
            const tagContainer = document.getElementById(tagContainerId);

            function drawTags() {
                tagContainer.innerHTML = "";

                Array.from(select.selectedOptions).forEach(option => {
                    const tag = document.createElement("span");
                    tag.className = "selected-tag";
                    tag.innerHTML = `
                                <span>${option.text}</span>
                                <button type="button" class="tag-remove" data-value="${option.value}">&times;</button>
                            `;
                    tagContainer.appendChild(tag);
                });

                bindRemoveButtons();
            }

            function bindRemoveButtons() {
                tagContainer.querySelectorAll(".tag-remove").forEach(button => {
                    button.addEventListener("click", function () {
                        const value = this.getAttribute("data-value");
                        const option = Array.from(select.options).find(o => o.value === value);

                        if (option) {
                            option.selected = false;
                        }

                        drawTags();
                    });
                });
            }

            select.addEventListener("change", drawTags);
            drawTags();
        }

        document.addEventListener("DOMContentLoaded", function () {
            renderSelectedTags("SelectedProfessionIds", "profession-tags");
            renderSelectedTags("SelectedSchemeIds", "scheme-tags");
            renderSelectedTags("SelectedPensionIds", "pension-tags");
            renderSelectedTags("SelectedVehicleTypeIds", "vehicletype-tags");
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}