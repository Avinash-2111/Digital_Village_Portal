@model MyVillageApp.Domain.Leaders.Leader

@{

    ViewData["Title"] = "Edit Leader";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .leader-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 20px;
        gap: 12px;
    }

    .leader-title {
        font-size: 32px;
        font-weight: 700;
        color: #198754;
    }

    .top-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .leader-card {
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
    }

    .form-control {
        border-radius: 12px;
        padding: 10px;
    }

    .form-label {
        font-weight: 600;
    }

    .image-preview {
        border-radius: 16px;
        border: 2px dashed #dee2e6;
        padding: 10px;
        background: #f8f9fa;
    }

    .submit-btn {
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .leader-title {
            font-size: 24px;
        }

        .top-buttons a {
            width: 100%;
            text-align: center;
        }

        .leader-card {
            padding: 15px !important;
        }
    }
</style>

<div class="container-fluid mt-4 px-3">

    <!-- HEADER -->
    <div class="leader-header">
        <h1 class="leader-title">
            <i class="bi bi-pencil-square me-2"></i>Edit Leader
        </h1>

        <div class="top-buttons">
            <a asp-action="Leaders" class="btn btn-outline-success">
                <i class="bi bi-arrow-left-circle"></i> Back to Leaders
            </a>

            <a asp-action="Dashboard" asp-controller="Admin" class="btn btn-outline-primary">
                <i class="bi bi-speedometer2"></i> Admin Dashboard
            </a>
        </div>
    </div>

    <!-- CARD -->
    <div class="card leader-card p-4 bg-white">

        <form asp-action="EditLeader" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Photo" />

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label">Leader Name</label>
                    <input asp-for="Name" class="form-control" placeholder="Enter leader name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="VillageRole" class="form-label">Village Role</label>
                    <input asp-for="VillageRole" class="form-control" placeholder="Enter village role" />
                    <span asp-validation-for="VillageRole" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="WardNumber" class="form-label">Ward Number</label>
                    <input asp-for="WardNumber" class="form-control" placeholder="Enter ward number" />
                    <span asp-validation-for="WardNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="WardName" class="form-label">Ward Name</label>
                    <input asp-for="WardName" class="form-control" placeholder="Enter ward name" />
                    <span asp-validation-for="WardName" class="text-danger"></span>
                </div>

                <!-- IMAGE UPLOAD -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">Change Photo</label>
                    <input type="file"
                           name="photoFile"
                           class="form-control"
                           accept="image/*"
                           onchange="previewLeaderImage(event)" />
                </div>

                <!-- PREVIEW -->
                <div class="col-md-6 mb-3 text-center">
                    <div class="image-preview">
                        @if (!string.IsNullOrEmpty(Model.Photo))
                        {
                            <img id="leaderPreview"
                                 src="~/leaderphotos/@Model.Photo"
                                 alt="Leader Photo"
                                 class="img-fluid rounded"
                                 style="width:200px;height:200px;object-fit:cover;" />
                        }
                        else
                        {
                            <img id="leaderPreview"
                                 src="https://via.placeholder.com/200x200?text=No+Image"
                                 alt="Preview"
                                 class="img-fluid rounded"
                                 style="width:200px;height:200px;object-fit:cover;" />
                        }
                    </div>
                </div>

            </div>

            <!-- BUTTONS -->
            <div class="mt-3">
                <button type="submit" class="btn btn-primary submit-btn">
                    <i class="bi bi-check-circle"></i> Update
                </button>

                <a asp-action="Leaders" class="btn btn-secondary submit-btn ms-2">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <script>
        function previewLeaderImage(event) {
            const input = event.target;
            const preview = document.getElementById('leaderPreview');

            if (input.files && input.files[0]) {
                preview.src = URL.createObjectURL(input.files[0]);
            }
        }
    </script>
}