@model MyVillageApp.Domain.FamilyMembers.FamilyMember

@{

    ViewData["Title"] = "Delete FamilyMember ";
}

<div class="container mt-5">

    <div class="card shadow-lg p-4 rounded">

        <h2 class="text-danger mb-4">Delete FamilyMember</h2>

        <h5>Are you sure you want to delete this member from  Family?</h5>

        <hr />

        <div class="mb-3">
            <strong>Name:</strong>
            <span class="text-primary">@Model.Name</span>
        </div>

        <form asp-action="DeleteFamilyMemberConfirmed" method="post">

            <input type="hidden" name="id" value="@Model.Id" />

            <button type="submit" class="btn btn-danger me-2">
                Yes, Delete
            </button>

            <a asp-action="FamilyMembers" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>