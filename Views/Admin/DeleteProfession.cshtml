@model MyVillageApp.Domain.Professions.Profession

@{

    ViewData["Title"] = "Delete Profession";
}

<div class="container mt-5">

    <div class="card shadow-lg p-4 rounded">

        <h2 class="text-danger mb-4">Delete Scheme</h2>

        <h5>Are you sure you want to delete this scheme?</h5>

        <hr />

        <div class="mb-3">
            <strong>Scheme Name:</strong>
            <span class="text-primary">@Model.ProfessionName</span>
        </div>

        <form asp-action="DeleteProfessionConfirmed" method="post">

            <input type="hidden" name="id" value="@Model.Id" />

            <button type="submit" class="btn btn-danger me-2">
                Yes, Delete
            </button>

            <a asp-action="Professions" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>