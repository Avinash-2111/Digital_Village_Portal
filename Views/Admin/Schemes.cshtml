@model List<MyVillageApp.Domain.Schemes.Scheme>

@{
    
    ViewData["Title"] = "Schemes";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .schemes-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .schemes-title {
        font-size: 34px;
        font-weight: 700;
        color: #198754;
        margin-bottom: 6px;
    }

    .schemes-subtitle {
        color: #6c757d;
        margin-bottom: 0;
    }

    .top-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .page-btn {
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 16px;
    }

    .schemes-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-radius: 12px;
    }

    .schemes-table {
        min-width: 650px;
        margin-bottom: 0;
    }

        .schemes-table thead th {
            background: #198754;
            color: #fff;
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
            font-size: 14px;
        }

        .schemes-table tbody td {
            vertical-align: middle;
            white-space: nowrap;
            font-size: 14px;
        }

    .empty-box {
        background: #fff3cd;
        color: #856404;
        border-radius: 12px;
        padding: 14px 16px;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .schemes-title {
            font-size: 26px;
        }

        .schemes-subtitle {
            font-size: 14px;
        }

        .top-actions {
            width: 100%;
        }

            .top-actions a {
                flex: 1 1 100%;
                text-align: center;
            }

        .schemes-card {
            padding: 14px !important;
        }

        .schemes-table thead th,
        .schemes-table tbody td {
            font-size: 13px;
            padding: 10px 8px;
        }
    }
</style>

<div class="container-fluid mt-4 px-3">

    <div class="schemes-page-header">
        <div>
            <h1 class="schemes-title">Schemes</h1>
            <p class="schemes-subtitle">Manage village scheme names and records</p>
        </div>

        <div class="top-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success page-btn">
                <i class="bi bi-house-door-fill me-2"></i>Back to Home
            </a>

            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-primary page-btn">
                <i class="bi bi-speedometer2 me-2"></i>Back to Admin Dashboard
            </a>

            <a asp-action="CreateScheme" class="btn btn-success page-btn">
                <i class="bi bi-plus-circle me-2"></i>Create Scheme
            </a>
        </div>
    </div>

    <div class="schemes-card p-4 bg-white">

        @if (Model == null || !Model.Any())
        {
            <div class="empty-box">
                We have no schemes in the list
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-bordered table-striped align-middle schemes-table">
                    <thead>
                        <tr>
                            <th>Scheme Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var scheme in Model)
                        {
                            <tr>
                                <td>@scheme.SchemeName</td>
                                <td>
                                    <a asp-action="EditScheme"
                                       asp-route-id="@scheme.Id"
                                       class="btn btn-warning btn-sm me-1 mb-1">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </a>

                                    <a asp-action="DeleteScheme"
                                       asp-route-id="@scheme.Id"
                                       class="btn btn-danger btn-sm mb-1">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>