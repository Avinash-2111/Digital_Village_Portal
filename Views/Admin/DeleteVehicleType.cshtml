@model MyVillageApp.Domain.VehicleTypes.VehicleType

@{

    ViewData["Title"] = "Delete VechileType";
}

<div class="container mt-5">

    <div class="card shadow-lg p-4 rounded">

        <h2 class="text-danger mb-4">Delete VechileType</h2>

        <h5>Are you sure you want to delete this VechileType?</h5>

        <hr />

        <div class="mb-3">
            <strong>VechileType:</strong>
            <span class="text-primary">@Model.VehicleTypeName</span>
        </div>

        <form asp-action="DeleteVehicleTypeConfirmed" method="post">

            <input type="hidden" name="id" value="@Model.Id" />

            <button type="submit" class="btn btn-danger me-2">
                Yes, Delete
            </button>

            <a asp-action="VehicleTypes" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>