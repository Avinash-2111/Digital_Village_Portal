@model MyVillageApp.Domain.VehicleTypes.VehicleType

@{
  
    ViewData["Title"] = "Edit Vehicle Type";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .vehicle-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .vehicle-title {
        font-size: 32px;
        font-weight: 700;
        color: #0d6efd;
    }

    .top-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .page-btn {
        border-radius: 10px;
        padding: 10px 16px;
        font-weight: 600;
    }

    .vehicle-card {
        max-width: 600px;
        margin: auto;
        border-radius: 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
        padding: 25px;
    }

    .form-control {
        border-radius: 10px;
        padding: 12px;
    }

    .actions {
        margin-top: 20px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    @@media (max-width: 768px) {
        .vehicle-title {
            font-size: 24px;
        }

        .top-actions a {
            width: 100%;
            text-align: center;
        }

        .actions .btn {
            width: 100%;
        }
    }
</style>

<div class="container mt-4">

    <!-- HEADER -->
    <div class="vehicle-page-header">
        <h2 class="vehicle-title">
            <i class="bi bi-pencil-square me-2"></i>Edit Vehicle Type
        </h2>

        <div class="top-actions">
            <a asp-controller="Admin" asp-action="VehicleTypes" class="btn btn-outline-success page-btn">
                <i class="bi bi-arrow-left-circle"></i> Back to Vehicle Types
            </a>

            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-primary page-btn">
                <i class="bi bi-speedometer2"></i> Admin Dashboard
            </a>
        </div>
    </div>

    <!-- CARD -->
    <div class="card vehicle-card">

        <form asp-action="EditVehicleType" method="post">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="VehicleTypeName" class="form-label fw-semibold">Vehicle Type Name</label>
                <input asp-for="VehicleTypeName"
                       class="form-control"
                       placeholder="Enter vehicle type name" />
                <span asp-validation-for="VehicleTypeName" class="text-danger"></span>
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Update
                </button>

                <a asp-controller="Admin" asp-action="VehicleTypes" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}