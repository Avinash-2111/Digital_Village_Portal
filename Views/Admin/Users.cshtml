@model List<MyVillageApp.Domain.Users.User>

@{

    ViewData["Title"] = "Users Management";

    var currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    var totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 0;
    var searchText = ViewBag.SearchText != null ? ViewBag.SearchText.ToString() : "";
    var totalCount = ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : 0;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .users-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .users-title {
        font-size: 34px;
        font-weight: 700;
        color: #198754;
        margin-bottom: 6px;
    }

    .users-subtitle {
        color: #6c757d;
        margin-bottom: 0;
    }

    .top-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .page-btn {
        border-radius: 10px;
        font-weight: 600;
        padding: 10px 16px;
    }

    .users-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .search-bar-wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .search-form {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        width: 100%;
        max-width: 520px;
    }

    .table thead th {
        background: #198754;
        color: #fff;
        vertical-align: middle;
        text-align: center;
        white-space: nowrap;
    }

    .table tbody td {
        vertical-align: middle;
        white-space: nowrap;
    }

    .role-select {
        min-width: 120px;
    }

    .user-row-form {
        display: contents;
    }

    .pagination-wrap {
        display: flex;
        justify-content: center;
        margin-top: 20px;
        flex-wrap: wrap;
        gap: 6px;
    }

        .pagination-wrap .btn {
            min-width: 42px;
            border-radius: 8px;
        }

    .count-badge {
        background: #e9f7ef;
        color: #198754;
        border-radius: 12px;
        padding: 8px 14px;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .users-title {
            font-size: 26px;
        }

        .users-subtitle {
            font-size: 14px;
        }

        .top-actions {
            width: 100%;
        }

            .top-actions a {
                flex: 1 1 100%;
                text-align: center;
            }

        .search-form {
            max-width: 100%;
        }

            .search-form input,
            .search-form button,
            .search-form a {
                width: 100%;
            }

        .count-badge {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="container-fluid mt-4 px-3">

    <div class="users-page-header">
        <div>
            <h1 class="users-title">Users Management</h1>
            <p class="users-subtitle">Manage registered users and update roles easily</p>
        </div>

        <div class="top-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-success page-btn">
                <i class="bi bi-house-door-fill me-2"></i>Back to Home
            </a>

            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-primary page-btn">
                <i class="bi bi-speedometer2 me-2"></i>Back to Admin Dashboard
            </a>
        </div>
    </div>

    <div class="users-card p-4 bg-white">

        <div class="search-bar-wrap">
            <form method="get" asp-action="Users" class="search-form">
                <input type="text"
                       name="searchText"
                       value="@searchText"
                       class="form-control"
                       placeholder="Search by username" />

                <button type="submit" class="btn btn-primary page-btn">
                    <i class="bi bi-search me-1"></i>Search
                </button>

                <a asp-action="Users" class="btn btn-secondary page-btn">
                    <i class="bi bi-arrow-clockwise me-1"></i>Reset
                </a>
            </form>

            <div class="count-badge">
                Total Users: @totalCount
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-warning mb-0">
                No users found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>User Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Password</th>
                            <th>Role</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <form method="post" asp-action="UpdateRole" class="user-row-form">
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td>@user.PhoneNumber</td>
                                <td>******</td>
                                <td>
                                    <input type="hidden" name="userId" value="@user.Id" />

                                    <select name="role" class="form-select role-select">
                                            @if (user.Role == "User")
                                            {
                                            <option value="User" selected>User</option>
                                            <option value="Admin">Admin</option>
                                            }
                                            else
                                            {
                                            <option value="User">User</option>
                                            <option value="Admin" selected>Admin</option>
                                            }
                                    </select>
                                </td>
                                <td>
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="bi bi-check2-circle me-1"></i>Save
                                    </button>
                                </td>
                                </form>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="pagination-wrap">
                    <a asp-action="Users"
                       asp-route-searchText="@searchText"
                       asp-route-page="@(currentPage - 1)"
                       class="btn btn-outline-secondary @(currentPage <= 1 ? "disabled" : "")">
                        <i class="bi bi-chevron-left"></i>
                    </a>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a asp-action="Users"
                           asp-route-searchText="@searchText"
                           asp-route-page="@i"
                           class="btn @(i == currentPage ? "btn-success" : "btn-outline-success")">
                            @i
                        </a>
                    }

                    <a asp-action="Users"
                       asp-route-searchText="@searchText"
                       asp-route-page="@(currentPage + 1)"
                       class="btn btn-outline-secondary @(currentPage >= totalPages ? "disabled" : "")">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            }
        }
    </div>
</div>