@model List<MyVillageApp.Domain.Wishes.Wish>

@{
  
    ViewData["Title"] = "Wishes";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<div class="container-fluid mt-4 px-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h1 class="text-success fw-bold mb-1">Wishes</h1>
            <p class="text-muted mb-0">Manage wishes and media</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Dashboard" class="btn btn-outline-primary">
                <i class="bi bi-speedometer2 me-1"></i>Admin Dashboard
            </a>
            <a asp-action="CreateWish" class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i>Create Wish
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 p-4">
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-warning mb-0">No wishes found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle mb-0">
                    <thead class="table-success">
                        <tr>
                            <th>Wish Name</th>
                            <th>Day Name</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.WishName</td>
                                <td>@item.DayName</td>
                                <td>@item.DateOfCreate.ToString("dd-MM-yyyy")</td>
                                <td>
                                    <a asp-action="EditWish" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1">Edit</a>
                                    <a asp-action="DeleteWish" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>