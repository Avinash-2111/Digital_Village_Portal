@model MyVillageApp.Domain.Pets.Pet

@{
 
    ViewData["Title"] = "Delete Pet";
}

<div class="container mt-5">
    <div class="card shadow p-4">
        <h2 class="text-danger mb-4">Delete Pet</h2>

        <h5>Are you sure you want to delete this pet?</h5>
        <hr />

        <p><strong>Pet Name:</strong> @Model.PetName</p>

        <form asp-action="DeletePetConfirmed" method="post">
            <input type="hidden" name="id" value="@Model.Id" />

            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Pets" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>