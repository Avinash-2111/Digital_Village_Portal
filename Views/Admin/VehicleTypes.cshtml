@model List<MyVillageApp.Domain.VehicleTypes.VehicleType>

@{
   
    ViewData["Title"] = "Vehicle Types";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    .vehicle-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

    .vehicle-title {
        font-size: 32px;
        font-weight: 700;
        color: #198754;
    }

    .top-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .page-btn {
        border-radius: 10px;
        padding: 10px 16px;
        font-weight: 600;
    }

    .vehicle-card {
        border-radius: 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        border: none;
        padding: 20px;
        background: white;
    }

    .table-wrap {
        overflow-x: auto;
    }

    .vehicle-table {
        min-width: 600px;
    }

        .vehicle-table thead th {
            background: #198754;
            color: white;
            text-align: center;
        }

        .vehicle-table td {
            text-align: center;
            vertical-align: middle;
        }

    .empty-box {
        background: #fff3cd;
        padding: 15px;
        border-radius: 10px;
        font-weight: 600;
        color: #856404;
    }

    @@media (max-width: 768px) {
        .vehicle-title {
            font-size: 22px;
        }

        .top-actions {
            width: 100%;
        }

            .top-actions a {
                width: 100%;
                text-align: center;
            }

        .vehicle-card {
            padding: 12px !important;
        }
    }
</style>

<div class="container mt-4">

    <!-- HEADER -->
    <div class="vehicle-page-header">

        <h2 class="vehicle-title">
            <i class="bi bi-truck me-2"></i>Vehicle Types
        </h2>

        <div class="top-actions">

            <a asp-controller="Home" asp-action="Index"
               class="btn btn-outline-success page-btn">
                <i class="bi bi-house-door"></i> Home
            </a>

            <a asp-controller="Admin" asp-action="Dashboard"
               class="btn btn-outline-primary page-btn">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <a asp-action="CreateVehicleType"
               class="btn btn-success page-btn">
                <i class="bi bi-plus-circle"></i> Create New
            </a>

        </div>

    </div>

    <!-- CARD -->
    <div class="card vehicle-card">

        @if (Model == null || !Model.Any())
        {
            <div class="empty-box">
                No vehicle types found
            </div>
        }
        else
        {
            <div class="table-wrap">

                <table class="table table-bordered table-striped vehicle-table">

                    <thead>
                        <tr>
                            <th>Vehicle Type Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.VehicleTypeName</td>

                                <td>
                                    <a asp-action="EditVehicleType"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm me-1">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>

                                    <a asp-action="DeleteVehicleType"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }

    </div>

</div>