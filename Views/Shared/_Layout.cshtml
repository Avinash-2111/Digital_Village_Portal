@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = ViewData["Title"] ?? "Jangiligonda Village Portal";

    var cmPhoto = "https://www.telangana.gov.in/wp-content/uploads/2025/11/cm-telangana.png";
    var deputyCmPhoto = "https://tse1.mm.bing.net/th/id/OIP.9c6cmJH_JQsIahUcLN46qAHaEc?w=474&amp;h=474&amp;c=7&amp;p=0";
    var revenueMinisterPhoto = "https://www.telangana.gov.in/wp-content/uploads/2023/12/Sri-Ponguleti-Srinivas-Reddy-837x1024.jpg";
    var mlaPhoto = "https://prsindia.org/files/mlatrack/telangana/3/mla_images/Dr.%20Murali%20Naik%20Bhukya.jpg";
    var mpPhoto = "https://www.telangana.gov.in/wp-content/uploads/2024/06/Sri-Porika-Balram-Naik.jpg";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Jangiligonda Village Portal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --gov-primary: #0b5e2b;
            --gov-secondary: #0f7a38;
            --gov-accent: #f4b400;
            --gov-light: #f4f7fb;
            --gov-dark: #1c1c1c;
            --gov-border: #dce3ea;
            --gov-text: #2d3748;
            --gov-maroon: #7a1f1f;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            background: var(--gov-light);
            color: var(--gov-text);
        }

        a {
            text-decoration: none;
        }

        /* TOP MINI HEADER */
        .top-strip {
            background: #083d1c;
            color: #fff;
            font-size: 13px;
            padding: 6px 0;
        }

            .top-strip .top-inner {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 10px;
                flex-wrap: wrap;
            }

            .top-strip .left-text,
            .top-strip .right-text {
                opacity: 0.95;
            }

        /* BRAND HEADER */
        .brand-header {
            background: linear-gradient(135deg, #ffffff 0%, #eef7f0 100%);
            border-bottom: 1px solid var(--gov-border);
            padding: 14px 0;
        }

        .brand-box {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .brand-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .brand-logo {
            width: 74px;
            height: 74px;
            min-width: 74px;
            border-radius: 50%;
            background: #fff;
            border: 3px solid #dce8d7;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.08);
        }

        .brand-title h1 {
            font-size: 30px;
            margin: 0;
            color: var(--gov-primary);
            font-weight: 800;
            letter-spacing: 0.3px;
        }

        .brand-title p {
            margin: 4px 0 0;
            font-size: 14px;
            color: #55606f;
            font-weight: 500;
        }

        .brand-badges {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .badge-box {
            background: #fff;
            border: 1px solid var(--gov-border);
            border-left: 4px solid var(--gov-primary);
            border-radius: 10px;
            padding: 10px 14px;
            min-width: 150px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.04);
        }

            .badge-box strong {
                display: block;
                font-size: 13px;
                color: var(--gov-primary);
            }

            .badge-box span {
                font-size: 12px;
                color: #667085;
            }

        /* LEADERS */
        .leaders-section {
            background: linear-gradient(90deg, var(--gov-primary), var(--gov-secondary));
            padding: 12px 0;
            box-shadow: inset 0 -1px 0 rgba(255,255,255,0.1);
        }

        .leaders-scroll {
            display: flex;
            gap: 14px;
            overflow-x: auto;
            padding-bottom: 2px;
            scrollbar-width: thin;
        }

            .leaders-scroll::-webkit-scrollbar {
                height: 6px;
            }

            .leaders-scroll::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.35);
                border-radius: 10px;
            }

        .leader-card {
            min-width: 240px;
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(255,255,255,0.14);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 14px;
            padding: 10px 12px;
            backdrop-filter: blur(2px);
        }

            .leader-card img {
                width: 52px;
                height: 52px;
                object-fit: cover;
                border-radius: 50%;
                border: 2px solid #fff;
                background: #fff;
                flex-shrink: 0;
            }

        .leader-info strong {
            display: block;
            color: #fff;
            font-size: 13px;
            line-height: 1.2;
        }

        .leader-info span {
            display: block;
            color: #eaf8ee;
            font-size: 12px;
            margin-top: 2px;
        }

        /* NOTICE BAR */
        .notice-bar {
            background: #fff8e8;
            border-top: 1px solid #f1dfb0;
            border-bottom: 1px solid #f1dfb0;
            padding: 10px 0;
        }

        .notice-wrap {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .notice-label {
            background: var(--gov-maroon);
            color: #fff;
            padding: 7px 14px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
        }

        .notice-text {
            overflow: hidden;
            white-space: nowrap;
            width: 100%;
            color: #6b4f00;
            font-weight: 600;
        }

            .notice-text marquee {
                margin-bottom: -4px;
            }

        /* NAVBAR */
        .main-navbar {
            background: var(--gov-primary) !important;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 21px;
            letter-spacing: 0.2px;
        }

        .navbar-nav .nav-link {
            color: #fff !important;
            font-weight: 600;
            padding: 10px 14px !important;
            border-radius: 8px;
            margin: 2px 4px;
            transition: all 0.25s ease;
        }

            .navbar-nav .nav-link:hover,
            .navbar-nav .nav-link:focus {
                background: rgba(255,255,255,0.12);
            }

        .right-menu {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .welcome-badge {
            background: rgba(255,255,255,0.14);
            color: #fff;
            border: 1px solid rgba(255,255,255,0.18);
            padding: 8px 12px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 14px;
        }

        .btn-gov-light {
            background: #fff;
            color: var(--gov-primary);
            border: none;
            font-weight: 700;
            border-radius: 8px;
            padding: 9px 16px;
        }

        .btn-gov-warning {
            background: var(--gov-accent);
            color: #222;
            border: none;
            font-weight: 700;
            border-radius: 8px;
            padding: 9px 16px;
        }

        .btn-gov-danger {
            background: #dc3545;
            color: #fff;
            border: none;
            font-weight: 700;
            border-radius: 8px;
            padding: 9px 16px;
        }

        .btn-gov-info {
            background: #0dcaf0;
            color: #111;
            border: none;
            font-weight: 700;
            border-radius: 8px;
            padding: 9px 16px;
        }

        /* PAGE BODY */
        .page-wrapper {
            padding: 24px 0;
            min-height: 70vh;
        }

        .page-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
            padding: 24px;
            border: 1px solid #edf1f5;
        }

        /* FOOTER */
        .footer {
            background: linear-gradient(135deg, #102818 0%, #173c23 100%);
            color: #fff;
            margin-top: 40px;
            padding-top: 28px;
        }

        .footer-top {
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.12);
        }

        .footer h5 {
            font-size: 17px;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .footer p,
        .footer li,
        .footer a {
            color: #dcebdd;
            font-size: 14px;
        }

            .footer a:hover {
                color: #fff;
            }

        .footer-bottom {
            padding: 14px 0;
            text-align: center;
            font-size: 14px;
            color: #d9e5db;
        }

        /* MOBILE RESPONSIVE */
        @@media (max-width: 991.98px) {
            .brand-box {
                flex-direction: column;
                align-items: flex-start;
            }

            .brand-left {
                width: 100%;
            }

            .brand-title h1 {
                font-size: 24px;
            }

            .brand-title p {
                font-size: 13px;
            }

            .brand-badges {
                width: 100%;
            }

            .badge-box {
                flex: 1 1 100%;
            }

            .right-menu {
                margin-top: 14px;
                width: 100%;
                flex-direction: column;
                align-items: stretch;
            }

                .right-menu a,
                .right-menu span {
                    width: 100%;
                    text-align: center;
                }

            .page-wrapper {
                padding: 16px 0;
            }

            .page-card {
                padding: 16px;
                border-radius: 12px;
            }
        }

        @@media (max-width: 767.98px) {
            .top-strip .top-inner {
                flex-direction: column;
                align-items: flex-start;
            }

            .brand-left {
                align-items: flex-start;
            }

            .brand-logo {
                width: 62px;
                height: 62px;
                min-width: 62px;
                font-size: 22px;
            }

            .brand-title h1 {
                font-size: 20px;
            }

            .leader-card {
                min-width: 200px;
            }

            .notice-wrap {
                flex-direction: column;
                align-items: flex-start;
            }

            .notice-label {
                width: 100%;
                text-align: center;
            }

            .navbar-brand {
                font-size: 17px;
            }
        }

        @@media (max-width: 575.98px) {
            .brand-left {
                flex-direction: column;
                text-align: center;
                align-items: center;
            }

            .brand-box {
                align-items: center;
                text-align: center;
            }

            .brand-badges {
                justify-content: center;
            }

            .leaders-scroll {
                gap: 10px;
            }

            .leader-card {
                min-width: 180px;
                padding: 8px 10px;
            }

                .leader-card img {
                    width: 46px;
                    height: 46px;
                }

            .page-card {
                padding: 14px;
            }
        }
    </style>
</head>
<body>

    <!-- TOP STRIP -->
    <div class="top-strip">
        <div class="container">
            <div class="top-inner">
                <div class="left-text">Government Village Information Portal</div>
                <div class="right-text">Serving Citizens with Transparency and Digital Access</div>
            </div>
        </div>
    </div>

    <!-- BRAND HEADER -->
    <div class="brand-header">
        <div class="container">
            <div class="brand-box">
                <div class="brand-left">
                    <div class="brand-logo">🏛</div>
                    <div class="brand-title">
                        <h1>Jangiligonda Village Portal</h1>
                        <p>Digital Governance • Citizen Services • Village Information Management System</p>
                    </div>
                </div>

                <div class="brand-badges">
                    <div class="badge-box">
                        <strong>District</strong>
                        <span>Mahabubabad</span>
                    </div>
                    <div class="badge-box">
                        <strong>State</strong>
                        <span>Telangana</span>
                    </div>
                    <div class="badge-box">
                        <strong>Service Mode</strong>
                        <span>Online Public Access</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- LEADERS SECTION -->
    <div class="leaders-section">
        <div class="container">
            <div class="leaders-scroll">

                <div class="leader-card">
                    <img src="@cmPhoto" alt="Telangana CM" onerror="this.src='https://via.placeholder.com/52x52?text=CM'" />
                    <div class="leader-info">
                        <strong>Chief Minister</strong>
                        <span>Revanth Reddy</span>
                    </div>
                </div>

                <div class="leader-card">
                    <img src="@deputyCmPhoto" alt="Deputy CM" onerror="this.src='https://via.placeholder.com/52x52?text=DCM'" />
                    <div class="leader-info">
                        <strong>Deputy Chief Minister</strong>
                        <span>Bhatti Vikramarka</span>
                    </div>
                </div>

                <div class="leader-card">
                    <img src="@revenueMinisterPhoto" alt="Revenue Minister" onerror="this.src='https://via.placeholder.com/52x52?text=RM'" />
                    <div class="leader-info">
                        <strong>Revenue Minister</strong>
                        <span>Ponguleti Srinivas Reddy</span>
                    </div>
                </div>

                <div class="leader-card">
                    <img src="@mlaPhoto" alt="MLA" onerror="this.src='https://via.placeholder.com/52x52?text=MLA'" />
                    <div class="leader-info">
                        <strong>MLA</strong>
                        <span>Dr. Murali Naik</span>
                    </div>
                </div>

                <div class="leader-card">
                    <img src="@mpPhoto" alt="MP" onerror="this.src='https://via.placeholder.com/52x52?text=MP'" />
                    <div class="leader-info">
                        <strong>Member of Parliament</strong>
                        <span>Balram Naik</span>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- NOTICE BAR -->
    <div class="notice-bar">
        <div class="container">
            <div class="notice-wrap">
                <div class="notice-label">Latest Updates</div>
                <div class="notice-text">
                    <marquee behavior="scroll" direction="left" scrollamount="5">
                        Welcome to Jangiligonda Village Portal | Citizen services, welfare schemes, family details, pension information, profession data and village records available digitally.
                    </marquee>
                </div>
            </div>
        </div>
    </div>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark main-navbar">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Village Portal</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu" aria-controls="navbarMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMenu">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Village" asp-action="Families">Families</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Village" asp-action="Schemes">Schemes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Village" asp-action="Professions">Professions</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Village" asp-action="Pensions">Pensions</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Village" asp-action="VehicleTypes">Vehicles</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Village" asp-action="Disabled">Disabled</a>
                    </li>
                </ul>

                <div class="right-menu">
                    @if (Context.Session.GetString("UserEmail") == null)
                    {
                        <a class="btn btn-gov-light" asp-controller="Account" asp-action="Register">Register</a>
                        <a class="btn btn-gov-warning" asp-controller="Account" asp-action="Login">Login</a>
                    }
                    else
                    {
                        @if (Context.Session.GetString("UserRole") == "Admin")
                        {
                            <a class="btn btn-gov-info" asp-controller="Admin" asp-action="Dashboard">Admin Dashboard</a>
                        }

                        <span class="welcome-badge">Welcome @Context.Session.GetString("UserName")</span>
                        <a class="btn btn-gov-danger" asp-controller="Account" asp-action="Logout">Logout</a>
                    }
                </div>

            </div>
        </div>
    </nav>

    <!-- BODY -->
    <div class="page-wrapper">
        <div class="container">
            <div class="page-card">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container footer-top">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5>About Portal</h5>
                    <p>
                        Jangiligonda Village Portal is a digital public information platform for managing
                        village records, welfare details, families, pensions, professions, and citizen services.
                    </p>
                </div>
                <div class="col-md-4">
                    <h5>Quick Links</h5>
                    <p><a asp-controller="Home" asp-action="Index">Home</a></p>
                    <p><a asp-controller="Village" asp-action="Families">Families</a></p>
                    <p><a asp-controller="Village" asp-action="Schemes">Schemes</a></p>
                    <p><a asp-controller="Village" asp-action="Pensions">Pensions</a></p>
                </div>
                <div class="col-md-4">
                    <h5>Contact</h5>
                    <p>Village Administration Office</p>
                    <p>Mahabubabad District, Telangana</p>
                    <p>Email: support@villageportal.in</p>
                </div>
            </div>
        </div>

        <div class="container footer-bottom">
            © @DateTime.Now.Year Jangiligonda Village Portal | Digital Village Information System
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>